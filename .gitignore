# ─── Dependencies ─────────────────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log*

# ─── Environment & secrets (never commit) ───────────────
.env
.env.*
!.env.example
*.pem
**/service-account*.json
**/google-credentials.json
**/credentials.json
**/*-credentials.json

# ─── IDEs & editors ──────────────────────────────────────
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Test output ─────────────────────────────────────────
test-output/
**/test-output/
coverage/

# ─── Temporary / scratch files ───────────────────────────
# Anything starting with `.tmp-` is a debug dump (we use this pattern
# for ad-hoc preview output during development). `*.bak` files are
# session backups. `*-scratch.*` / `scratch/` catches exploration dumps.
.tmp-*
*.tmp
*.bak
*.orig
*-scratch.*
scratch/

# ─── Dev scripts (exploration harnesses, stress tests, phase verifiers) ─
# Situational — written for specific debugging sessions and go stale
# fast. Proper regression tests live under packages/*/src/tests/ and
# run via `npm test`.
scripts/

# ─── NPM artifacts ───────────────────────────────────────
*.tgz
.npm/

# ─── TSC output leaked into src ──────────────────────────
# tsc-watch occasionally emits .js/.d.ts next to .ts sources. We want
# only the .ts source checked in, never the compiled siblings.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# Exception: hand-authored ambient type declarations for npm packages
# that ship without their own types (svg-parser, others). These ARE
# source files — the rule above wants to drop tsc output, not typings.
!packages/core/src/importers/svg-parser.d.ts

# ─── Legacy studio package (removed, keep path ignored) ──
# We removed packages/studio in favor of the platform UI served by
# the MCP sidecar. Any leftover files from old checkouts should not
# be tracked.
packages/studio/

# ─── reframe local data (generated at runtime) ──────────
# Covers .reframe/scenes, /exports, /brands, /src, /history,
# /intents, /annotations, /threads, /snapshots, design.md, etc.
# Nothing in here is source of truth — it's all derived from the
# package source + user actions.
.reframe/

# ─── MCP config (user-specific paths/api keys) ──────────
.mcp.json
!.mcp.json.example

# ─── Phase scratch reports outside .reframe/ ────────────
phase*-report.md
*-scratch.md
