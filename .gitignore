# ─── Dependencies ─────────────────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log*

# ─── Environment & secrets (never commit) ───────────────
.env
.env.*
!.env.example
*.pem
**/service-account*.json
**/google-credentials.json
**/credentials.json
**/*-credentials.json

# ─── IDEs & editors ──────────────────────────────────────
.vscode/
.idea/
.cursor/
# .claude/ is user-scoped by default (settings.local.json, worktrees),
# but .claude/skills/ ships with the repo — these are the "costume" that
# teaches Claude Code how to be a reframe agent and benefit every user
# who clones the project.
.claude/*
!.claude/skills/
!.claude/skills/**
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Test output ─────────────────────────────────────────
test-output/
**/test-output/
coverage/

# ─── Temporary / scratch files ───────────────────────────
# Anything starting with `.tmp-` is a debug dump (we use this pattern
# for ad-hoc preview output during development). `*.bak` files are
# session backups. `*-scratch.*` / `scratch/` catches exploration dumps.
.tmp-*
*.tmp
*.bak
*.orig
*-scratch.*
scratch/

# ─── Dev scripts (exploration harnesses, stress tests, phase verifiers) ─
# Situational — written for specific debugging sessions and go stale
# fast. Proper regression tests live under packages/*/src/tests/ and
# run via `npm test`. The scripts/dev-qa/ folder hosts the local
# Playwright UI smoke harness — used by the maintainer to find/fix
# bugs interactively. Not part of the product, not pushed.
# Use `scripts/*` (not `scripts/`) so negations below can re-include
# specific files — git won't descend into a fully-ignored directory.
scripts/*
# Exception: copy-platform-assets.mjs is a permanent post-build step
# for @reframe/mcp (copies platform-ui.js / platform-ui.css into dist).
# It MUST ship — the npm build breaks without it.
!scripts/copy-platform-assets.mjs
# Exceptions: permanent test runners referenced by root `npm test`.
# Without these the first `npm test` after clone fails out of the box.
!scripts/test-pipeline.ts
!scripts/test-reframe-all.ts
!scripts/test-scene-import-parity.ts

# ─── NPM artifacts ───────────────────────────────────────
*.tgz
.npm/

# ─── TSC output leaked into src ──────────────────────────
# tsc-watch occasionally emits .js/.d.ts next to .ts sources. We want
# only the .ts source checked in, never the compiled siblings.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# Exception: hand-authored ambient type declarations for npm packages
# that ship without their own types (svg-parser, others). These ARE
# source files — the rule above wants to drop tsc output, not typings.
!packages/core/src/importers/svg-parser.d.ts
# Exception: platform/ui/*.js are hand-authored Platform UI modules
# that get concatenated at build time into dist/.../platform-ui.js.
# They're source, not tsc output.
!packages/mcp/src/platform/ui/*.js

# ─── Legacy studio package (removed, keep path ignored) ──
# We removed packages/studio in favor of the platform UI served by
# the MCP sidecar. Any leftover files from old checkouts should not
# be tracked.
packages/studio/

# ─── reframe local data (generated at runtime) ──────────
# Covers .reframe/scenes, /exports, /brands, /src, /history,
# /intents, /annotations, /threads, /snapshots, design.md, etc.
# Nothing in here is source of truth — it's all derived from the
# package source + user actions.
.reframe/

# ─── MCP config (user-specific paths/api keys) ──────────
.mcp.json
!.mcp.json.example

# ─── Playwright ─────────────────────────────────────────
# Browser binaries are installed globally, test results are ephemeral.
test-results/
playwright-report/

# ─── Phase scratch reports outside .reframe/ ────────────
phase*-report.md
*-scratch.md

# ─── Ad-hoc test/stress scripts in root ─────────────────
# Leading `/` anchors to repo root — we don't want this to match
# scripts/test-*.ts (those are permanent runners whitelisted above).
/test-*.ts
/test-*.js

# ─── Ad-hoc export output in repo root ──────────────────
# Probe scripts under scripts/ write exports (pdf/tsx/lottie/site)
# to repo root for manual inspection. Disposable, regenerated
# every run — nothing here belongs in version control.
/*.pdf
/*.tsx
/*.lottie.json
/*.module.css
/*-animated.html
/*.export.html
/*.export.tsx
/stress-site.html
